{
  "name": "ai-simultaneous-interpretation-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite --host 0.0.0.0 --config frontend/vite.config.js",
    "dev:backend": "nodemon backend/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --host 0.0.0.0 --config frontend/vite.config.js",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "less": "^4.6.4",
    "nodemon": "^3.1.10",
    "vite": "^8.0.16"
  }
}
